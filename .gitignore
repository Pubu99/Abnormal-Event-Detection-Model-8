# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/
ENV/
venv.bak/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Test and coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/

# Type/checker caches
.mypy_cache/
.dmypy.json
.pyre/

# Jupyter
.ipynb_checkpoints

# Logs and runtime files
*.log
logs/
*.pid
*.seed
*.pid.lock

# Local env files
.env
.env.*
credentials.json
secrets.yml

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE/editor
.vscode/
.idea/
*.sublime-* 
*.code-workspace

# PyInstaller
*.manifest
*.spec

# Pyre, pylance
.pyre/

# Node / Frontend
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Webpack / bundler caches
.cache/

# Uploaded files and runtime generated data
backend/api/uploads/
backend/uploads/
uploads/
data/uploads/

# Database files
*.sqlite3
*.db
*.db-journal

# Model artifacts (large binaries) - note: tracked files already in git are unaffected
*.pt
*.pth
*.ckpt
models/*.pt
models/*.pth

# Temporary files
*.tmp
*.temp
*.swp
*~

# Coverage reports
coverage/

# Misc
.envrc
.vagrant/

# If you create runtime policy backups etc
*.bak
*.tmp
*.retrain*.json

# Documentation folder (do not upload docs or large docs assets)
docs/
docs/**

# Keep these patterns at the end so tracked files aren't accidentally deleted by git operations
# If you want to remove already tracked large files (models, data), run the suggested git commands below.
